<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBrush" Color="#D4786E"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#C05A4E"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FBE5E0"/>
    <SolidColorBrush x:Key="BgBrush" Color="#FDF8F0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFBFA"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F5EDE3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E8DDD4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#4A3728"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B7355"/>
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#F0E6DA"/>
    <SolidColorBrush x:Key="MissBubbleBrush" Color="#FBE5E0"/>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#8B7355"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#D4786E"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C05A4E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#F5EDE3"/>
        <Setter Property="Foreground" Value="#8B7355"/>
        <Setter Property="BorderBrush" Value="#E8DDD4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
