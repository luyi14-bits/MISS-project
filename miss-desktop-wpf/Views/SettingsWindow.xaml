<Window x:Class="MISS.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API 设置" Width="460" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <TextBlock Text="API 连接设置" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">

                <!-- Section: Provider -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="API 提供商" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ProviderCombo" Padding="10,8" FontSize="13"
                                  Background="{DynamicResource BgBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  SelectionChanged="ProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="OpenAI / 官方" Tag="openai"/>
                            <ComboBoxItem Content="OpenAI 兼容 / 中转" Tag="openai-compat"/>
                            <ComboBoxItem Content="DeepSeek" Tag="deepseek"/>
                            <ComboBoxItem Content="自定义接口" Tag="custom"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section: API Key -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ApiKeyInput"
                                     Padding="10,8" FontSize="13"
                                     Background="{DynamicResource BgBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"/>
                        <TextBlock Text="密钥仅保存在本地，不会上传" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Section: API URL -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="API 地址" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="BaseUrlInput" Padding="10,8" FontSize="13"
                                 Background="{DynamicResource BgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <!-- Section: Model -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="模型" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ModelCombo" Padding="10,8" FontSize="13"
                                  Background="{DynamicResource BgBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  IsEditable="True" Text="gpt-4o-mini">
                            <ComboBoxItem Content="gpt-4o-mini（便宜快速）" Tag="gpt-4o-mini"/>
                            <ComboBoxItem Content="gpt-4o（最强）" Tag="gpt-4o"/>
                            <ComboBoxItem Content="deepseek-v4-flash（最新极速）" Tag="deepseek-v4-flash"/>
                            <ComboBoxItem Content="deepseek-v4-pro（最强推理）" Tag="deepseek-v4-pro"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="测试连接" Style="{DynamicResource SecondaryButtonStyle}"
                        Click="TestConnection_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="保存" Style="{DynamicResource PrimaryButtonStyle}"
                        Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
