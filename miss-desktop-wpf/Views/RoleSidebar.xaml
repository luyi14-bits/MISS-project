<UserControl x:Class="MISS.Views.RoleSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MISS.Models"
             xmlns:vm="clr-namespace:MISS.ViewModels"
             xmlns:views="clr-namespace:MISS.Views">
    <UserControl.Resources>
        <views:RoleAvatarConverter x:Key="RoleAvatarConverter"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Collapse toggle -->
            <Button Grid.Row="0" Content="«" Width="24" Height="24"
                    HorizontalAlignment="Right" Margin="0,4,4,0"
                    Style="{DynamicResource IconButtonStyle}" FontSize="10"
                    Click="ToggleCollapse_Click"
                    ToolTip="折叠侧边栏"/>

            <!-- Session area -->
            <Border Grid.Row="1" Padding="10,8,10,6">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="会话" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="+ 新建" HorizontalAlignment="Right"
                                Style="{DynamicResource IconButtonStyle}" FontSize="12"
                                Command="{Binding CreateSessionCommand}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                    <ListBox x:Name="SessionListBox"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding CurrentSession, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="160"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SessionData}">
                                <Border Padding="8,5" Cursor="Hand"
                                        Background="Transparent"
                                        CornerRadius="4" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Width="18" Height="18"
                                                Style="{DynamicResource IconButtonStyle}" FontSize="10"
                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="删除会话"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Row="2" Background="{DynamicResource BorderBrush}" Margin="12,0"/>

            <!-- Role header -->
            <Border Grid.Row="3" Padding="10,6,10,6">
                <Grid>
                    <TextBlock Text="角色" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+" Width="28" Height="28" ToolTip="新建角色"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="CreateRole_Click"/>
                        <Button Content="★" Width="28" Height="28" ToolTip="导出 JSON"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="ExportRole_Click" FontSize="14"/>
                        <Button Content="🎴" Width="28" Height="28" ToolTip="导出 ST 角色卡"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="ExportTavernCard_Click" FontSize="12"/>
                        <Button Content="🏠" Width="28" Height="28" ToolTip="加入当前房间"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="AddToRoom_Click" FontSize="12"/>
                        <Button Content="↓" Width="28" Height="28" ToolTip="导入"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="ImportRole_Click" FontSize="12"/>
                        <Button Content="×" Width="28" Height="28" ToolTip="删除当前角色"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="DeleteRole_Click" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Role list with MVVM binding -->
            <ListBox x:Name="RoleListBox" Grid.Row="4"
                     ItemsSource="{Binding Roles}"
                     SelectedItem="{Binding CurrentRole, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:RoleData}">
                        <Border Padding="10,8" Cursor="Hand"
                                Background="Transparent"
                                CornerRadius="4" Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0">
                                    <!-- Fallback: colored circle for custom roles -->
                                    <Ellipse Width="28" Height="28" Fill="{DynamicResource PrimaryLightBrush}"/>
                                    <!-- Avatar loaded via converter from filesystem -->
                                    <Image Width="28" Height="28" Stretch="UniformToFill"
                                           Source="{Binding Name, Converter={StaticResource RoleAvatarConverter}}">
                                        <Image.Clip>
                                            <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
